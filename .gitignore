# Secrets & local config — never commit real credentials.
# Only *.env.example files are allowed to be tracked.
.env
.env.*
!.env.example
smra/.env
smra/.env.*
!smra/.env.example

# Local docs / references
/references
smra/DEMO_SCRIPT.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.benchmarks/

# Virtual environments
.venv/
venv/
env/

# Data artifacts (regenerated locally — see smra/data/load_db.py)
*.db
*.db-journal
*.db.bak
*.sqlite
*.sqlite3
smra/data/*.pkl
smra/pdfs/*.pdf

# Audit / logs
*.log

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
