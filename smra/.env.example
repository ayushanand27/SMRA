# Example .env file for SMRA (placeholders — DO NOT commit real secrets)

# LLM provider and keys
LLM_PROVIDER=groq                # groq | ollama | gemini | mock (mock only with MOCK_MODE=1)
MOCK_MODE=0                      # 1 = synthetic LLM/RAG/Web stubs for infra load tests (opt-in)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=mixtral-8x7b-32768    # optional, if using Groq

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gemini (Google)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Pinecone (RAG)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-west1-gcp        # Pinecone environment/region (if required)
PINECONE_INDEX=smra-index        # index name used by the project
PINECONE_DIMENSION=384           # must match embedding model (384 for all-MiniLM-L6-v2)
PINECONE_DISABLED=0             # set to 1 to force local RAG fallback (rag_local_store.pkl)

# Embeddings model (used locally when creating vectors)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tavily (web search)
TAVILY_API_KEY=tvly_your_key_here

# OCR settings (Windows examples)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\path\to\poppler\bin
OCR_MAX_PAGES=0                   # 0 = process all pages, >0 = limit for testing
OCR_FORCE=0                       # 1 = force OCR path (skip text-first extraction)

# Database / misc
# Postgres URL; unset = SQLite fallback (DATABASE_PATH). On Windows use 127.0.0.1:5434 not localhost:5432.
# Docker: docker run -d --name smra-pg -e POSTGRES_PASSWORD=smra -e POSTGRES_DB=smra -p 5434:5432 postgres:16-alpine
DATABASE_URL=postgresql+psycopg2://postgres:smra@127.0.0.1:5434/smra
DATABASE_PATH=smra/data/smra.db

# Live ingestion (requires Postgres DATABASE_URL; starts with FastAPI, not Streamlit)
INGESTION_ENABLED=1
INGESTION_INTERVAL_MIN=30
QUERY_CACHE_ENABLED=1
CACHE_TTL_SECONDS=1800

# Semantic answer cache (opt-in; exact match then embedding similarity)
SEMANTIC_CACHE_ENABLED=0
SEMANTIC_CACHE_THRESHOLD=0.80          # MiniLM paraphrase hits ~0.80-0.90; raise to reduce false positives
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MAX_ENTRIES=200

# Observability
LOG_LEVEL=INFO
JSON_LOGS=0                       # 1 = structured JSON logs for production aggregation

# Langfuse (managed LLM tracing) — optional
LANGFUSE_ENABLED=0               # 1 to send traces to Langfuse
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key

# API auth & rate limiting (FastAPI service)
AUTH_ENABLED=0                   # 1 to require X-API-Key on /query and /audit
SMRA_API_KEYS=                   # comma-separated allow-list, e.g. key1,key2
RATE_LIMIT_ENABLED=1             # 1 to enforce per-key/IP rate limiting
RATE_LIMIT_PER_MIN=30            # requests allowed per identity per minute
REDIS_URL=redis://localhost:6379 # shared rate-limit store; set to empty/memory to force in-process only

# Streamlit UI gate (optional shared password)
UI_PASSWORD=                     # set to require a password before using the UI

# Guardrails (OWASP LLM Top 10 - first defense layer)
GUARDRAILS_ENABLED=1             # 0 to disable input guardrails (not recommended)
MAX_INPUT_CHARS=2000             # reject over-long queries (context-overflow probes)

# LLM tuning
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.0              # 0 = deterministic (audit-friendly)

# RAG tuning
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.5          # below this -> web fallback

# Optional flags
# If you want to force use of local embeddings/Pinecone fallback, set:
# PINECONE_DISABLED=1

# End of example
